# Day 04 Lab v3 — IT Helpdesk Agent
# Copy this file to `.env` (same folder) and fill in your keys.
# NEVER commit `.env` — it is gitignored. Keys here are NAMES ONLY (no values).

# Offline UI demo. Local helpdesk tools still run; output is not lab evidence.
DEMO_MODE=false

# Provider used by the web UI: gemini, ninerouter, openrouter, openai, or anthropic.
AGENT_PROVIDER=gemini

# --- 9Router (OpenAI-compatible) ---
NINEROUTER_BASE_URL=http://localhost:20128/v1
NINEROUTER_API_KEY=
NINEROUTER_MODEL=kr/claude-sonnet-4.5

# --- Model provider (choose ONE; OpenRouter recommended) ---
OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Helpdesk tools use deterministic local mock data and need no additional keys.

# --- Optional external device search (Tavily) ---
TAVILY_API_KEY=
